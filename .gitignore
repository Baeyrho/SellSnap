# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# os-generated files
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
Desktop.ini

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log*
pnpm-debug.log*

# local env files
.env*.local
.env.development
.env.production
.env.test
.env.staging

# Prisma CLI env file — holds a live connection string. Use .env.example as the template.
.env
!.env.example

# editor
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
.idea

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/app/generated/prisma

# local dev uploads (no Vercel Blob token)
/public/uploads

# local database files (Prisma targets PostgreSQL — dev.db is a stale SQLite artifact)
*.db
*.sqlite
*.sqlite3
