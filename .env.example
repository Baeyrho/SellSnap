# SellSnap environment template.
#
# Copy this file to .env.local and fill in real values. Also create .env with
# DATABASE_URL, because the Prisma CLI loads .env via prisma.config.ts.
#
# .env, .env.local and .env.*.local are git-ignored. Never commit real values.
# Only variables prefixed with NEXT_PUBLIC_ are exposed to the browser.

# ---------------------------------------------------------------------------
# Database (required)
# ---------------------------------------------------------------------------
# PostgreSQL connection string. Nothing renders without it.
DATABASE_URL=

# ---------------------------------------------------------------------------
# Auth — NextAuth v5 (required)
# ---------------------------------------------------------------------------
# Signs and encrypts session JWTs. Generate with: openssl rand -base64 32
# In production an unset secret throws MissingSecretError.
NEXTAUTH_SECRET=
# Canonical origin of the deployment, e.g. http://localhost:3000
NEXTAUTH_URL=

# ---------------------------------------------------------------------------
# App URL (required in production)
# ---------------------------------------------------------------------------
# Absolute origin used for payment redirect URLs, password-reset links and
# email-change confirmation links.
# Validated once at boot (instrumentation). In production it must be set and
# must use https, or the server refuses to start — a wrong value would send
# reset/confirmation tokens to the wrong host. Locally it falls back to
# http://localhost:3000.
NEXT_PUBLIC_APP_URL=

# ---------------------------------------------------------------------------
# Flutterwave (required to take payments)
# ---------------------------------------------------------------------------
# Secret key. Server-side only. Creates subaccounts, charges and verifies
# transactions.
FLUTTERWAVE_SECRET_KEY=
# Secret hash from the Flutterwave dashboard, compared against the verif-hash
# header on every webhook delivery.
FLUTTERWAVE_SECRET_HASH=

# ---------------------------------------------------------------------------
# Email — SMTP (optional)
# ---------------------------------------------------------------------------
# Transactional email is skipped entirely when SMTP_HOST is unset.
SMTP_HOST=
# Defaults to 587 when unset.
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
# Defaults to "SellSnap <noreply@sellsnap.com>" when unset.
SMTP_FROM=
# Where operational alerts go: late payments, reversals that need a human, a cron that has
# stopped working. Defaults to SMTP_FROM when unset. Set this to a real monitored mailbox —
# see docs/OPERATIONS.md.
OPS_ALERT_EMAIL=

# ---------------------------------------------------------------------------
# Vercel Blob (required in production, optional locally)
# ---------------------------------------------------------------------------
# Without a token, images are written to public/uploads and are lost on
# every redeploy.
BLOB_READ_WRITE_TOKEN=

# ---------------------------------------------------------------------------
# Cron (required to run /api/cron/resolve-pending and /api/cron/operations)
# ---------------------------------------------------------------------------
# Guards the scheduled job that resolves stale PENDING orders and reconciles
# refunds, and the read-only operations report it writes findings to.
# Generate with: openssl rand -base64 32
# This same value is reused as the Vercel CRON_SECRET so Vercel can authenticate
# the scheduled request automatically.
CRON_SECRET=

# ---------------------------------------------------------------------------
# Intentionally unused (do not wire up)
# ---------------------------------------------------------------------------
# These two variables may exist in a local .env.local from earlier development.
# Neither is read by any code path. They are documented here so nobody re-adds
# behaviour behind them:
#
#   MOCK_MODE              — no mock/demo mode exists. The registration route no
#                            longer mentions it. Do not implement one behind it.
#   FLUTTERWAVE_PUBLIC_KEY — checkout is a server-side redirect to Flutterwave's
#                            hosted page. There is no browser SDK and no public
#                            key; exposing one would breach the security rules.
